# API密钥
ANYSEARCH_API_KEY=""
# HTTP接口鉴权token，公网务必设置
ANYSEARCH_API_TOKEN=""

# 代理池配置
ANYSEARCH_PROXIES=""
ANYSEARCH_PROXY_LIST_URL="https://cdn.jsdelivr.net/gh/parserpp/ip_ports/proxyinfo.json"

# 代理内存缓存
ANYSEARCH_PROXY_CACHE_ENABLE=true
ANYSEARCH_PROXY_CACHE_TTL_SEC=120

# HTTP服务
ANYSEARCH_HTTP_BIND=0.0.0.0
ANYSEARCH_HTTP_PORT=8123

# MCP SSE网络服务（远程MCP客户端连接）
ANYSEARCH_MCP_TOKEN=""
ANYSEARCH_MCP_SSE_BIND=0.0.0.0
ANYSEARCH_MCP_SSE_PORT=8124
ANYSEARCH_MCP_HTTP_PATH="/mcp"
